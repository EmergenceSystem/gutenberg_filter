{application, gutenberg_filter, [
    {description, "em_filter agent for Project Gutenberg ebook search"},
    {vsn, "0.2.0"},
    {registered, [gutenberg_filter_sup, gutenberg_filter_server]},
    {mod, {gutenberg_filter_app, []}},
    {applications, [
        kernel,
        stdlib,
        cowboy,
        em_filter
    ]},
    {env, [
        {pop_port,   0},
        {query_port, 0},
        {pop_seeds,  []}
    ]},
    {modules, [
        gutenberg_filter_sup,
        gutenberg_filter_server
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/gutenberg_filter"}]}
]}.
